generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id @default("main")
  name      String   @default("")
  title     String   @default("")
  bio       String?  @db.Text
  longBio   String?  @db.LongText
  location  String?
  email     String?
  github    String?
  twitter   String?
  linkedin  String?
  website   String?
  avatar    String?
  updatedAt DateTime @updatedAt
}

model Skill {
  id       String @id @default(cuid())
  name     String
  level    Int    @default(50)
  category String @default("Other")
  order    Int    @default(0)
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  content     String?  @db.LongText
  image       String?
  tags        String   @default("[]")
  github      String?
  demo        String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?   @db.Text
  content     String?   @db.LongText
  image       String?
  tags        String    @default("[]")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@fulltext([title, excerpt, content])
}

model DocCategory {
  id    String    @id @default(cuid())
  name  String
  slug  String    @unique
  order Int       @default(0)
  pages DocPage[]
}

model DocPage {
  id         String       @id @default(cuid())
  title      String
  slug       String       @unique
  content    String?      @db.LongText
  categoryId String?
  category   DocCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  order      Int          @default(0)
  published  Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@fulltext([title, content])
}

model Tutorial {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String?  @db.Text
  content    String?  @db.LongText
  image      String?
  tags       String   @default("[]")
  difficulty String   @default("beginner")
  duration   Int?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@fulltext([title, excerpt, content])
}
